{
  "name": "urbanvision-backend",
  "version": "1.0.0",
  "description": "AI-powered municipal road inspection and maintenance backend",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "NODE_OPTIONS=\"--experimental-vm-modules\" NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles",
    "test:coverage": "NODE_OPTIONS=\"--experimental-vm-modules\" NODE_ENV=test jest --runInBand --forceExit --detectOpenHandles --coverage",
    "seed:supervisor": "node src/scripts/seedSupervisor.js"
  },
  "keywords": [
    "urbanvision",
    "municipal",
    "ai",
    "gemini"
  ],
  "license": "MIT",
  "dependencies": {
    "@google/genai": "^2.31.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "joi": "^18.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.4",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "jest": {
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src/tests"
    ],
    "testTimeout": 60000
  }
}
